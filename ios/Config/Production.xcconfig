// Optional ignored machine-local values for direct Xcode device builds.
// Xcode Cloud injects the same build-setting names through its environment.
#include? "Production.xcconfig.local"

PRODUCT_BUNDLE_IDENTIFIER = com.illinicover.app
PRODUCT_NAME = IlliniCover
INFOPLIST_FILE = Config/Info-Production.plist
IC_DISPLAY_NAME = IlliniCover
IC_URL_SCHEME = illinicover
IC_API_BASE_URL = https:/$()/illinicover-api-1068900473446.us-east5.run.app
// Required through Xcode Cloud or a local ignored Production.xcconfig.local.
// A production launch fails closed while this is blank or a Test Store key.
IC_REVENUECAT_API_KEY = $(ILLINICOVER_REVENUECAT_APPLE_KEY)
IC_ENVIRONMENT = production
// Optional public integration values are injected by the release workflow.
// Blank keeps monitoring/support mail disabled without inventing a destination.
IC_SENTRY_DSN = $(ILLINICOVER_SENTRY_DSN)
IC_SUPPORT_EMAIL = $(ILLINICOVER_SUPPORT_EMAIL)
IC_PRIVACY_POLICY_URL = https:/$()/illinicover-api-1068900473446.us-east5.run.app/privacy
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) PRODUCTION
