IC_ENVIRONMENT = local
IC_SENTRY_DSN =
IC_SUPPORT_EMAIL =
IC_PRIVACY_POLICY_URL =
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEBUG LOCAL
