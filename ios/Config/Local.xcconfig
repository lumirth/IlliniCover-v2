PRODUCT_BUNDLE_IDENTIFIER = com.illinicover.app.dev
PRODUCT_NAME = IlliniCover
INFOPLIST_FILE = Config/Info-Local.plist
IC_DISPLAY_NAME = IlliniCover Local
IC_URL_SCHEME = illinicover-dev
